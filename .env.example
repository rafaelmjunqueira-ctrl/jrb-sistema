# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
# Valores em Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SECRET_KEY=sb_secret_...   # só servidor; nunca com prefixo NEXT_PUBLIC_
ASAAS_API_KEY=$aact_...          # Asaas > Integrações > Chaves de API (Secret, só servidor)
ASAAS_WEBHOOK_TOKEN=...          # mesmo token configurado no webhook do Asaas
# ASAAS_AMBIENTE=sandbox         # só para testes
